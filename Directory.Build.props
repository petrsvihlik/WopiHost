<Project>
	<PropertyGroup>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<!-- Pinned rather than `latest`. `latest` resolves to whatever the installed SDK's compiler
		     supports, so a side-by-side preview SDK silently raises the language version and its
		     analyzer defaults — and with TreatWarningsAsErrors that breaks the build on one
		     machine and not another. Raise deliberately, together with the global.json pin. -->
		<LangVersion>14.0</LangVersion>
		<!-- Centralize bin/obj/package/publish output under repo-root artifacts/.
		     ArtifactsPath is pinned here so that test projects (which have their
		     own Directory.Build.props) don't end up with a separate test/artifacts/. -->
		<UseArtifactsOutput>true</UseArtifactsOutput>
		<ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
		<!-- IDE0005 (remove unnecessary usings) only fires at build-time when XML docs
		     are generated, so enable doc generation everywhere. Non-packable projects
		     silence CS1591 below to avoid missing-doc warning floods. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!--
		  Exclude the E2E suites from default `dotnet test` runs. They need Docker, a real
		  client-container cold start and Playwright; running them on every PR would burn CI
		  minutes and gate PRs on flaky upstream integrations.

		  This replaces the repo-root .runsettings TestCaseFilter. Microsoft.Testing.Platform
		  does not read .runsettings at all, so the exclusion moves to xUnit's own MTP filter,
		  appended to every test project's command line via this property.

		  Filtering every test away is an error to MTP (exit code 8, ZeroTests) — so
		  WopiHost.E2ETests, whose entire suite carries the trait, needs to opt out of that
		  expectation. It does so in its own csproj rather than here, so the other test
		  projects keep failing loudly if their tests ever vanish.

		  To opt back in for a single run, override this property to empty and pass the
		  positive filter — unlike the old runsettings, MTP does not AND the two filters
		  together. See test/WopiHost.E2ETests/README.md.
		-->
		<TestingPlatformCommandLineArguments>--filter-not-trait "Category=E2E"</TestingPlatformCommandLineArguments>
	</PropertyGroup>

	<!-- WopiHost.Cobalt depends on the proprietary Microsoft.CobaltCore package, restored from a
	     private GitHub Packages feed. Gate the whole Cobalt surface on whether that feed is
	     reachable so a fork / external clone with no access still builds the rest of the solution.
	     Reachable when the token is set (COBALT_PACKAGES_TOKEN, e.g. on CI) OR a user-level
	     NuGet.Config declares the private feed (a maintainer who ran `dotnet nuget add source`).
	     The user-config path differs per OS, so probe every known location. Force either way with
	     -p:IncludeCobalt=true|false. nuget.config maps the cobalt feed to Microsoft.CobaltCore only,
	     so when it's absent restore never touches the feed and Cobalt + its tests compile as no-ops. -->
	<PropertyGroup>
		<_CobaltFeedMarker>nuget.pkg.github.com/petrsvihlik</_CobaltFeedMarker>
		<_NuGetUserConfigWin Condition="'$(APPDATA)' != ''">$(APPDATA)\NuGet\NuGet.Config</_NuGetUserConfigWin>
		<_NuGetUserConfigNix Condition="'$(HOME)' != ''">$(HOME)/.nuget/NuGet/NuGet.Config</_NuGetUserConfigNix>
		<_NuGetUserConfigXdg Condition="'$(XDG_CONFIG_HOME)' != ''">$(XDG_CONFIG_HOME)/NuGet/NuGet.Config</_NuGetUserConfigXdg>
		<_NuGetUserConfigXdg Condition="'$(_NuGetUserConfigXdg)' == '' and '$(HOME)' != ''">$(HOME)/.config/NuGet/NuGet.Config</_NuGetUserConfigXdg>
		<IncludeCobalt Condition="'$(IncludeCobalt)' == '' and '$(COBALT_PACKAGES_TOKEN)' != ''">true</IncludeCobalt>
		<!-- The user-config probe is a dev-machine convenience; on CI the token above is the only
		     signal, so the probe is skipped there ('CI' is set on GitHub runners) and whenever the
		     token has already decided. On a fresh runner the first restore creates the default user
		     NuGet.Config concurrently with property evaluation, and ReadAllText racing that write
		     fails the build with MSB4184 (sharing violation). The Exists() guard short-circuits so
		     a missing file is never read. -->
		<_ProbeNuGetUserConfig Condition="'$(IncludeCobalt)' == '' and '$(CI)' != 'true'">true</_ProbeNuGetUserConfig>
		<_NuGetUserConfigTextWin Condition="'$(_ProbeNuGetUserConfig)' == 'true' and '$(_NuGetUserConfigWin)' != '' and Exists('$(_NuGetUserConfigWin)')">$([System.IO.File]::ReadAllText('$(_NuGetUserConfigWin)'))</_NuGetUserConfigTextWin>
		<_NuGetUserConfigTextNix Condition="'$(_ProbeNuGetUserConfig)' == 'true' and '$(_NuGetUserConfigNix)' != '' and Exists('$(_NuGetUserConfigNix)')">$([System.IO.File]::ReadAllText('$(_NuGetUserConfigNix)'))</_NuGetUserConfigTextNix>
		<_NuGetUserConfigTextXdg Condition="'$(_ProbeNuGetUserConfig)' == 'true' and '$(_NuGetUserConfigXdg)' != '' and Exists('$(_NuGetUserConfigXdg)')">$([System.IO.File]::ReadAllText('$(_NuGetUserConfigXdg)'))</_NuGetUserConfigTextXdg>
		<IncludeCobalt Condition="'$(IncludeCobalt)' == '' and $(_NuGetUserConfigTextWin.Contains('$(_CobaltFeedMarker)'))">true</IncludeCobalt>
		<IncludeCobalt Condition="'$(IncludeCobalt)' == '' and $(_NuGetUserConfigTextNix.Contains('$(_CobaltFeedMarker)'))">true</IncludeCobalt>
		<IncludeCobalt Condition="'$(IncludeCobalt)' == '' and $(_NuGetUserConfigTextXdg.Contains('$(_CobaltFeedMarker)'))">true</IncludeCobalt>
		<IncludeCobalt Condition="'$(IncludeCobalt)' == ''">false</IncludeCobalt>
	</PropertyGroup>

	<!-- Package Validation Configuration for NuGet packages.

	     PackageValidationBaselineVersion is the last NuGet-published version we validate the
	     current public surface against. It is auto-managed by the bump-baseline job in
	     .github/workflows/release.yml — DO NOT bump it manually in a feature PR. Manual bumps
	     have a nasty interaction with the release flow: the bump job runs immediately after
	     the package upload, and if master already shows the new value at that moment it skips
	     (because the value already matches the just-released version). A revert merging shortly
	     after the release then leaves the baseline at the wrong version with no auto-bump PR
	     queued. If you genuinely need to override the baseline (e.g. to skip a buggy release),
	     do it in its own dedicated PR, not bundled with API changes. -->
	<PropertyGroup>
		<PackageValidationBaselineVersion>9.2.0</PackageValidationBaselineVersion>
	</PropertyGroup>
	
	<ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>$(AssemblyName).Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
</Project>