<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>WopiHost.CellBridge Class Library</Description>
    <Authors>Petr Svihlik</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WopiHost.CellBridge</AssemblyName>
    <PackageId>WopiHost.CellBridge</PackageId>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>WOPI;MS-WOPI;MS-FSSHTTP;MS-FSSHTTPB;cellbridge;Office Online Server;Web Application Open Platform Interface</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/petrsvihlik/WopiHost.git</RepositoryUrl>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="..\..\img\logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- CellBridge.AspNetCore needs the shared framework, which also supplies the
         Microsoft.Extensions.* (options, DI, logging, configuration binding) assemblies used here. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WopiHost.Abstractions\WopiHost.Abstractions.csproj" />
  </ItemGroup>

  <!-- cellbridge (https://github.com/PatrickMatthiesen/cellbridge) has no NuGet release yet, so its
       libraries are consumed as source from a sibling checkout: $(CellBridgeRepoRoot), resolved in the
       root Directory.Build.props. CellBridge.AspNetCore brings FssHttp, FssHttpB, Storage and
       Storage.Abstractions transitively. Once the packages are published, replace these two
       ProjectReferences with PackageReferences (versions in Directory.Packages.props) and drop the
       $(IncludeCellBridge) gate. -->
  <ItemGroup Condition="'$(IncludeCellBridge)' == 'true'">
    <ProjectReference Include="$(CellBridgeRepoRoot)/src/CellBridge.AspNetCore/CellBridge.AspNetCore.csproj" />
    <ProjectReference Include="$(CellBridgeRepoRoot)/src/CellBridge.Storage.InMemory/CellBridge.Storage.InMemory.csproj" />
  </ItemGroup>

  <!-- Every source file here needs the cellbridge types, so without the checkout the project builds as
       a no-op (only SDK-generated assembly attributes compile). Consumers reference it conditionally on
       $(IncludeCellBridge), so nothing depends on the empty output. -->
  <PropertyGroup Condition="'$(IncludeCellBridge)' != 'true'">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

</Project>
